<!-- MainWindow.xaml is the shell. It is the only window that is opened. 
It only contains ContentControl and navigation buttons. The window itself never changes 
<ContentConotrol> is the magic piece. WPF lets us swap the displayed object:
$MainContent.Content = $AdminAppsView
From this the user now sees Admin Apps Page, and then later
$MainContent.Content = $UrlsView
For the user to see the URLS page
its the same window, but just with different content, instead of original configuration
of having multiple windows where Every window has:

its own controls
its own events
its own state

And you have to somehow pass data around between windows
-->

<Window xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title = "Profile Configuration"
        Height = "600"
        Width = "800"
        WindowStartupLocation = "CenterScreen">

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <!-- Where UserControls will appear -->
                <ContentControl
                Name="MainContent"
                Grid.Row="0" />

                <!-- Navigation Area -->
                <DockPanel Grid.Row="1" Margin="10">
                        <Label 
                        x:Name="StepLabel" 
                        Content="Step 1"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        
                        <Button x:Name="BackButton" Content="Back" Width="100" Margin="5"/>
                        
                        <Button x:Name="NextButton" Content="Next" Width="100" Margin="5"/>
                        </StackPanel>
                </DockPanel>
        </Grid>
</Window>