<!-- 
This UserControl represents the Applications step of the Profile Configuration.
It is loaded into MainWindow.xaml's ContentControl and displayed when CurrentIndex = 1.
User selections made on this page are stored in $ProfileConfig.Applications.
-->
<UserControl
        xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation">

        <StackPanel Margin="20">

                <TextBlock Text="Select Applications" FontSize="24"/>

                <CheckBox Content="Outlook"/>
                <CheckBox Content="Teams"/>

        </StackPanel>

</UserControl>