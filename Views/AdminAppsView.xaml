<!-- 
This UserControl represents the Admin Applications step of the Profile Configuration.
It is loaded into MainWindow.xaml's ContentControl and displayed when CurrentIndex = 0.
User selections made on this page are stored in $ProfileConfig.AdminApps.
-->
<UserControl
        xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        
        <StackPanel Margin="40">

                <TextBlock Text="Select Admin Applications" FontSize="24"/>

                <CheckBox Name="cbADUC" Content="Active Directory"/>

        </StackPanel>

</UserControl>