<!-- 
This UserControl represents the Web Browser step of the Profile Configuration.
It is loaded into MainWindow.xaml's ContentControl and displayed when CurrentIndex = 3.
User selections made on this page are stored in $ProfileConfig.WebBrowsers.
-->
<UserControl
        xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
        <StackPanel Margin="40">

                <TextBlock 
                        Text="Select Web Browser"
                        FontSize="24"
                        FontWeight="Bold"
                        Margin="0,0,0,20"/>

                <CheckBox x:Name="Chrome" Content="Chrome.exe" Margin="0,0,0,20"/>
                <CheckBox x:Name="Edge" Content="MSEdge.exe" Margin="0,0,0,20"/>

        </StackPanel>

</UserControl>